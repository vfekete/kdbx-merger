def write_output(kp, path, force):
    """Serialize and write the database without clobbering existing files
    (unless force) and without leaving partial files behind."""
    buf = io.BytesIO()
    kp.save(buf)
    directory = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(prefix=".merge-kdbx-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(buf.getbuffer())
            fh.flush()
            os.fsync(fh.fileno())
        if force:
            os.replace(tmp, path)
        else:
            os.link(tmp, path)      # atomic, fails if path exists
            os.unlink(tmp)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def obtain_output_secret(args):
    if args.password is not None:
        print("warning: a password given on the command line may be visible to other "
              "users (ps, shell history)", file=sys.stderr)
        return secret_from_argv(args.password)
    if args.secret_tool is not None:
        return secret_from_secret_tool(args.secret_tool)
    for _ in range(3):
        first = read_secret(f"New password for {args.output}: ")
        second = read_secret(f"Retype password for {args.output}: ")
        if first == second:
            second.wipe()
            if not len(first):
                print("warning: the merged database has an empty password", file=sys.stderr)
            return first
        first.wipe()
        second.wipe()
        print("  passwords do not match, try again", file=sys.stderr)
    raise SystemExit("error: passwords did not match")


HELP_EPILOG = """\
input password methods (-ip):
  user          Passwords are typed by the user. Every password that worked is
                tried on the following files first, so a password shared by
                several files is typed only once. After 3 wrong attempts the
                merge stops.
  secret-tool   Passwords are read from the Secret Service (GNOME Keyring,
                KeePassXC, ...) with `secret-tool`. The script asks once for a
                PIN; the password of FILE is looked up under the attribute
                    service = "<PIN>-<absolute path of FILE>"
                (the path exactly as written on the command line is tried
                too). Store one like this:
                    secret-tool store --label="kdbx file1" \\
                        service "1234-/home/me/file1.kdbx"
                If there is no entry, or it does not work, passwords of the
                previous files are tried; if none works you are asked whether
                to type the password or cancel the merge.

output password (-p / -ps / prompt):
  -p PASSWORD   given on the command line (visible in ps and shell history)
  -ps SPEC      from secret-tool: an item label, or attribute=value pairs
                ("service=kdbx-out,user=me") for `secret-tool lookup`
  (neither)     typed twice at the prompt

duplicates:
  An entry whose title already exists in the same folder is added as
  "title - N" (N = highest existing index + 1) with "source: <file>" appended
  to its notes. Identical attachments are stored once; entries carrying them
  get a note listing every input file in which the attachment was found.
  Folders are never duplicated: folders with the same path are one folder,
  also when a single input file contains same-named sibling folders.
  Names must be truly identical to match. Names that only look alike
  (letter case, extra spaces, differently encoded accents) are kept separate
  and reported during the merge.

input file wildcards:
  -i 'flower*.kdbx' uses every file matching the pattern (quoted or not).
  Matches of one pattern are merged in sorted order, at the pattern's place on
  the command line, e.g.  -i main.kdbx 'backup/*.kdbx'  merges main.kdbx first.
  A file matched or listed more than once is used once; the output file is
  never used as input. The final merge order is printed.

example:
  merge-kdbx -i file1.kdbx some/path/file2.kdbx -ip user -o merged.kdbx -p pw
"""


def expand_inputs(args):
    """Expand wildcard patterns in input names (also when quoted, so the shell
    did not expand them). Matches of one pattern are used in sorted order, at
    the pattern's place on the command line. A file is used only once, and the
    output file is never used as input."""
    paths, seen, expanded = [], set(), False
    for arg in args.input:
        if os.path.exists(arg) or not re.search(r"[*?[]", arg):
            matches = [arg]
        else:
            matches = sorted(m for m in glob.glob(arg, recursive=True) if os.path.isfile(m))
            if not matches:
                raise SystemExit(f"error: no input file matches {arg!r}")
            expanded = True
        for path in matches:
            if not os.path.isfile(path):
                raise SystemExit(f"error: input file not found: {path}")
            real = os.path.realpath(path)
            if real in seen:
                print(f"  note: {path} is given more than once, using it only once",
                      file=sys.stderr)
                continue
            if (matches != [arg] and os.path.exists(args.output)
                    and os.path.samefile(path, args.output)):
                print(f"  note: {path} matches {arg!r} but is the output file, skipped",
                      file=sys.stderr)
                continue
            seen.add(real)
            paths.append(path)
    if len(paths) < 2:
        raise SystemExit(f"error: at least two input files are required, found {len(paths)}")
    if expanded:
        print("inputs, in merge order:", file=sys.stderr)
        for n, path in enumerate(paths, start=1):
            print(f"  {n}. {path}", file=sys.stderr)
    args.input = paths


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="merge-kdbx",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Merge several KeePass KDBX files into one new KDBX file. "
                    "The first input is copied 1:1, the others are merged into it in "
                    "command line order. Nothing is overwritten; input files are "
                    "opened read-only.",
        epilog=HELP_EPILOG,
    )
    p.add_argument("-i", "--input", nargs="+", required=True, metavar="FILE",
                   help="input KDBX files (at least 2), in priority order; wildcards "
                        "(*, ?, [abc], **) are allowed, matches are used in sorted order")
    p.add_argument("-ip", "--input-password", choices=["user", "secret-tool"],
                   default="user", metavar="{user,secret-tool}",
                   help="how input passwords are obtained (default: user, see below)")
    p.add_argument("-o", "--output", required=True, metavar="FILE",
                   help="output KDBX file (must not exist unless --force)")
    out = p.add_mutually_exclusive_group()
    out.add_argument("-p", "--password", metavar="PASSWORD",
                     help="password for the output file (insecure: visible in ps/history)")
    out.add_argument("-ps", "--secret-tool", metavar="SPEC",
                     help="take the output password from secret-tool: an item label, "
                          "or attribute=value pairs for 'secret-tool lookup'")
    p.add_argument("-f", "--force", action="store_true",
                   help="overwrite an existing output file (never an input file)")
    p.add_argument("-v", "--verbose", action="store_true",
                   help="list renamed duplicate entries")
    args = p.parse_args(argv)
    return args


def main(argv=None):
    harden_process()
    os.umask(0o077)
    args = parse_args(sys.argv[1:] if argv is None else argv)
    expand_inputs(args)
    if os.path.exists(args.output):
        if any(os.path.samefile(args.output, p) for p in args.input):
            raise SystemExit("error: output file is one of the input files")
        if not args.force:
            raise SystemExit(f"error: output file exists: {args.output} (use --force)")

    output_secret = None
    if args.password is not None:
        # move the argv password into a wipeable buffer right away
        output_secret = obtain_output_secret(args)
        args.password = None

    creds = None
    out_kp = None
    try:
        creds = Credentials(args.input_password)
        out_kp = open_first(args.input[0], creds)
        print(f"copied   {args.input[0]}", file=sys.stderr)
        merger = Merger(out_kp, args.input[0], verbose=args.verbose)
        for i, path in enumerate(args.input[1:], start=1):
            source = load_source(path, creds, out_kp)
            if i == len(args.input) - 1:
                creds.wipe()                    # no more files to open
            try:
                merger.merge(source, path)
            finally:
                wipe_source(source)
                del source
                gc.collect()
            print(f"merged   {path}", file=sys.stderr)
        merger.finish()

        if output_secret is None:
            output_secret = obtain_output_secret(args)
        out_kp.password = output_secret
        out_kp._keyfile = None
        write_output(out_kp, args.output, args.force)
        s = merger.stats
        print(f"written  {args.output}: {s['entries_copied']} entries merged "
              f"({s['entries_renamed']} renamed as duplicates), "
              f"{s['groups_created']} groups created, "
              f"{s['groups_joined']} same-named groups joined", file=sys.stderr)
    finally:
        if creds is not None:
            creds.wipe()
        if output_secret is not None:
            output_secret.wipe()
        if out_kp is not None:
            out_kp._password = None
            try:
                wipe_database_keys(out_kp)
            except Exception:
                pass
        wipe_derived_keys()
        gc.collect()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\naborted", file=sys.stderr)
        sys.exit(130)
