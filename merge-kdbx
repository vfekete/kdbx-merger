# ---------------------------------------------------------------------------
# Secret handling
#
# Passwords never live in Python `str` objects (immutable, cannot be wiped).
# They are kept in a `bytearray` wrapped in `Secret`, and every key derived
# from them that we can reach (composite key, transformed key, master key) is
# zeroed in place as soon as the corresponding file is no longer needed.
# ---------------------------------------------------------------------------

_BYTES_DATA_OFFSET = sys.getsizeof(b"") - 1
_STR_DATA_OFFSET = sys.getsizeof("") - 1

# derived key material created while (de)crypting, wiped by wipe_derived_keys()
_derived_keys = []


def wipe(obj):
    """Overwrite the memory of a bytes-like or ASCII str object with zeros."""
    if obj is None:
        return
    if isinstance(obj, bytearray):
        if obj:
            buf = (ctypes.c_char * len(obj)).from_buffer(obj)
            ctypes.memset(ctypes.addressof(buf), 0, len(obj))
            del buf
    elif isinstance(obj, bytes):
        # objects of length 0/1 are interpreter-wide singletons - never touch
        if len(obj) > 1:
            ctypes.memset(id(obj) + _BYTES_DATA_OFFSET, 0, len(obj))
    elif isinstance(obj, str):
        # only compact ASCII strings have a predictable layout
        if len(obj) > 1 and obj.isascii():
            ctypes.memset(id(obj) + _STR_DATA_OFFSET, 0, len(obj))


class Secret:
    """A password held in a wipeable bytearray."""

    __slots__ = ("buf",)

    def __init__(self, buf):
        self.buf = buf

    def encode(self, *_args, **_kwargs):
        return self.buf

    def __len__(self):
        return len(self.buf)

    def __eq__(self, other):
        return isinstance(other, Secret) and hmac.compare_digest(self.buf, other.buf)

    __hash__ = None

    def __repr__(self):
        return "<Secret ***>"

    __str__ = __repr__

    def wipe(self):
        wipe(self.buf)
        self.buf.clear()


def _secure_compute_key_composite(password=None, keyfile=None):
    """Replacement for pykeepass' composite key computation that works on
    `Secret` objects and remembers intermediate keys so they can be wiped."""
    if not isinstance(password, Secret) or keyfile:
        return _original_compute_key_composite(password=password, keyfile=keyfile)
    password_composite = hashlib.sha256(password.buf).digest()
    composite = hashlib.sha256(password_composite).digest()
    _derived_keys.extend((password_composite, composite))
    return composite


_original_compute_key_composite = kdbx_common.compute_key_composite
for _module in (kdbx_common, kdbx_v3, kdbx_v4):
    _module.compute_key_composite = _secure_compute_key_composite


def wipe_derived_keys():
    for key in _derived_keys:
        wipe(key)
    _derived_keys.clear()


def wipe_database_keys(kp):
    """Zero all key material pykeepass keeps for an opened database."""
    body = kp.kdbx.body
    for name in ("transformed_key", "master_key"):
        wipe(body.get(name))
    if kp.version >= (4, 0):
        wipe(kp.kdbx.body.payload.inner_header.protected_stream_key.data)
    else:
        wipe(kp.kdbx.header.value.dynamic_header.protected_stream_key.data)
    kp._password = None
    wipe_derived_keys()


def harden_process():
    """Disable core dumps and ptrace / /proc/<pid>/mem access by other
    processes of the same user (Linux), so memory cannot be easily dumped."""
    try:
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (ImportError, ValueError, OSError):
        pass
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        PR_SET_DUMPABLE = 4
        libc.prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)
    except (OSError, AttributeError):
        pass


def read_secret(prompt):
    """Read a password without echo into a bytearray (never into a str).

    Reads byte by byte: single bytes are interpreter singletons in CPython, so
    no copy of the password ends up in a heap object we cannot wipe."""
    sys.stderr.write(prompt)
    sys.stderr.flush()
    buf = bytearray()
    fd = sys.stdin.fileno()
    if os.isatty(fd):
        import termios
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~(termios.ECHO | termios.ICANON)
        new[6][termios.VMIN] = 1
        new[6][termios.VTIME] = 0
        try:
            termios.tcsetattr(fd, termios.TCSAFLUSH, new)
            while True:
                ch = os.read(fd, 1)
                if ch in (b"", b"\n", b"\r"):
                    break
                if ch in (b"\x7f", b"\x08"):          # backspace
                    if buf:
                        # drop a whole UTF-8 sequence
                        while buf and (buf[-1] & 0xC0) == 0x80:
                            buf[-1] = 0
                            del buf[-1]
                        if buf:
                            buf[-1] = 0
                            del buf[-1]
                    continue
                if ch == b"\x15":                     # Ctrl-U
                    wipe(buf)
                    buf.clear()
                    continue
                if ch == b"\x04" and not buf:         # Ctrl-D
                    break
                buf += ch
        finally:
            termios.tcsetattr(fd, termios.TCSAFLUSH, old)
            sys.stderr.write("\n")
    else:
        # non-interactive (piped) input: one password per line
        while True:
            ch = os.read(fd, 1)
            if ch in (b"", b"\n"):
                break
            buf += ch
        if buf.endswith(b"\r"):
            buf[-1] = 0
            del buf[-1]
    # bytearray growth may have left stale copies in freed memory; copy into
    # an exactly sized buffer allocated once and wipe the original
    result = bytearray(len(buf))
    result[:] = buf
    wipe(buf)
    return Secret(result)


def read_line(prompt):
    """Read a (non-secret) answer line. Reads unbuffered so it never swallows
    input meant for a following password prompt."""
    sys.stderr.write(prompt)
    sys.stderr.flush()
    chars = []
    while True:
        ch = os.read(sys.stdin.fileno(), 1)
        if ch in (b"", b"\n"):
            break
        chars.append(ch)
    return b"".join(chars).decode("utf-8", "replace").strip()


def secret_from_argv(value):
    """Turn a command line password into a Secret and wipe the str copy."""
    secret = Secret(bytearray(value.encode("utf-8")))
    for i, arg in enumerate(sys.argv):
        if arg is value or arg == value:
            wipe(arg)
            sys.argv[i] = "***"
    wipe(value)
    return secret


def _read_process_output(cmd):
    """Run cmd, return (returncode, stdout as bytearray, stderr text)."""
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, bufsize=0)
    out = bytearray(1 << 16)
    used = 0
    while True:
        if used == len(out):
            bigger = bytearray(len(out) * 2)
            bigger[:used] = out
            wipe(out)
            out = bigger
        view = memoryview(out)[used:]
        n = proc.stdout.readinto(view)
        view.release()
        if not n:
            break
        used += n
    err = proc.stderr.read().decode("utf-8", "replace").strip()
    proc.wait()
    result = bytearray(used)
    result[:] = memoryview(out)[:used]
    wipe(out)
    return proc.returncode, result, err


def _require_secret_tool():
    if shutil.which("secret-tool") is None:
        raise SystemExit("error: secret-tool not found (package libsecret-tools)")


def secret_from_secret_tool(spec):
    """Fetch a password from the Secret Service via `secret-tool`.

    spec is either
      * attribute=value pairs separated by commas, e.g. "service=kdbx,user=me"
        -> `secret-tool lookup service kdbx user me`
      * a plain label (as given by `secret-tool store --label=...`)
        -> the item with exactly that label among items stored by secret-tool
    """
    _require_secret_tool()
    if "=" in spec:
        cmd = ["secret-tool", "lookup"]
        for pair in spec.split(","):
            key, _, value = pair.partition("=")
            cmd += [key.strip(), value.strip()]
        code, out, err = _read_process_output(cmd)
        if code != 0 or not out:
            wipe(out)
            raise SystemExit(f"error: secret-tool found no secret for {spec!r} {err}".rstrip())
        return Secret(out)

    cmd = ["secret-tool", "search", "--all", "--unlock",
           "xdg:schema", "org.freedesktop.Secret.Generic"]
    code, out, err = _read_process_output(cmd)
    try:
        # output: blocks of "[path]\nlabel = X\nsecret = Y\n..." lines
        matches = []
        current_label = None
        pos = 0
        label_prefix, secret_prefix = b"label = ", b"secret = "
        while pos < len(out):
            end = out.find(b"\n", pos)
            if end < 0:
                end = len(out)
            if out.startswith(b"[", pos):
                current_label = None
            elif out.startswith(label_prefix, pos):
                current_label = bytes(out[pos + len(label_prefix):end]).decode("utf-8", "replace")
            elif out.startswith(secret_prefix, pos) and current_label == spec:
                start = pos + len(secret_prefix)
                found = bytearray(end - start)
                found[:] = memoryview(out)[start:end]
                matches.append(found)
            pos = end + 1
    finally:
        wipe(out)
    if not matches:
        raise SystemExit(f"error: secret-tool has no item labelled {spec!r} {err}".rstrip())
    if len(matches) > 1:
        for m in matches:
            wipe(m)
        raise SystemExit(f"error: several secret-tool items are labelled {spec!r}; "
                         "use attribute=value lookup instead")
    return Secret(matches[0])


# ---------------------------------------------------------------------------
# Input credentials
# ---------------------------------------------------------------------------

class Credentials:
    """Obtains input database passwords.

    mode "user":        passwords typed by the user
    mode "secret-tool": password stored in the Secret Service under the
                        attribute  service = "<PIN>-<absolute file path>"
                        (the path as given on the command line works too)

    Every password that opened a file is kept in a pool and tried on the
    following files before asking again.  The pool and the PIN are wiped as
    soon as the last input file has been opened.
    """

    def __init__(self, mode):
        self.mode = mode
        self.pool = []
        self.pin = None
        if mode == "secret-tool":
            _require_secret_tool()
            self.pin = read_secret("secret-tool PIN: ")

    def wipe(self):
        for s in self.pool:
            s.wipe()
        self.pool.clear()
        if self.pin is not None:
            self.pin.wipe()
            self.pin = None
        wipe_derived_keys()
        gc.collect()

    def _remember(self, secret):
        if any(secret == s for s in self.pool):
            secret.wipe()
        else:
            self.pool.append(secret)

    def _lookup(self, path):
        candidates = [os.path.abspath(path)]
        if path != candidates[0]:
            candidates.append(path)
        for candidate in candidates:
            service = bytearray(self.pin.buf)
            service += b"-" + os.fsencode(candidate)
            arg = bytes(service)
            wipe(service)
            try:
                code, out, _err = _read_process_output(
                    [b"secret-tool", b"lookup", b"service", arg])
            finally:
                wipe(arg)
            if code == 0 and out:
                return Secret(out)
            wipe(out)
        return None

    def open(self, path, attempt):
        """Call attempt(secret) with candidate passwords until it returns a
        result (not None); return that result."""
        if self.mode == "secret-tool":
            secret = self._lookup(path)
            if secret is None:
                print(f"  no secret-tool entry for {path}", file=sys.stderr)
            else:
                result = attempt(secret)
                if result is not None:
                    self._remember(secret)
                    return result
                secret.wipe()
                print(f"  secret-tool password for {path} does not work", file=sys.stderr)

        for secret in self.pool:
            result = attempt(secret)
            if result is not None:
                return result

        if self.mode == "user":
            for n in range(3):
                secret = read_secret(f"Password for {path}: ")
                result = attempt(secret)
                if result is not None:
                    self._remember(secret)
                    return result
                secret.wipe()
                print(f"  wrong password for {path}" + (", try again" if n < 2 else ""),
                      file=sys.stderr)
            raise SystemExit(f"error: could not open {path}: invalid credentials")

        while True:
            answer = read_line(f"No working password for {path}. "
                               "[p]rovide password or [c]ancel merging? ").lower()
            if answer in ("p", "provide"):
                secret = read_secret(f"Password for {path}: ")
                result = attempt(secret)
                if result is not None:
                    self._remember(secret)
                    return result
                secret.wipe()
                print(f"  wrong password for {path}", file=sys.stderr)
            elif answer in ("c", "cancel", ""):
                raise SystemExit(f"merging cancelled at {path}; nothing was written")


# ---------------------------------------------------------------------------
# Reading input databases
# ---------------------------------------------------------------------------

TIME_TAGS = ("CreationTime", "LastModificationTime", "LastAccessTime",
             "ExpiryTime", "LocationChanged", "DeletionTime")


def _read_file(path):
    with open(path, "rb") as fh:          # strictly read-only
        return fh.read()


def open_first(path, creds):
    """Open the first input in this process - it becomes the output."""
    data = _read_file(path)

    def attempt(secret):
        try:
            return PyKeePass(io.BytesIO(data), password=secret)
        except CredentialsError:
            wipe_derived_keys()
            return None

    kp = creds.open(path, attempt)
    wipe_database_keys(kp)
    return kp


def export_source(src_kp, out_kp):
    """(child) Extract everything that will be merged, with times already
    converted to the output's KDBX format."""
    root = src_kp.tree.getroot()
    if src_kp.version[0] != out_kp.version[0]:
        for t in root.iter(*TIME_TAGS):
            if t.text:
                t.text = out_kp._encode_time(src_kp._decode_time(t.text))
    container = etree.Element("Source")
    icons = etree.SubElement(container, "CustomIcons")
    for icon in root.xpath("/KeePassFile/Meta/CustomIcons/Icon"):
        icons.append(icon)
    container.append(root.find("Root/Group"))
    binaries = []
    for i, data in enumerate(src_kp.binaries):
        protected = True
        if src_kp.version >= (4, 0):
            protected = bool(src_kp.payload.inner_header.binary[i].data[0] & 1)
        binaries.append((data, protected))
    return {"xml": etree.tostring(container), "binaries": binaries}


def _read_exact(fd, n):
    buf = bytearray(n)
    view = memoryview(buf)
    got = 0
    while got < n:
        k = os.readv(fd, [view[got:]])
        if k == 0:
            break
        got += k
    view.release()
    return buf, got


def load_source(path, creds, out_kp):
    """Decrypt an input in a forked child; the child only sends back the data
    to merge.  Password, keys and the decrypted file die with the child."""
    def attempt(secret):
        r, w = os.pipe()
        sys.stdout.flush()
        sys.stderr.flush()
        pid = os.fork()
        if pid == 0:                                   # child
            code = 1
            try:
                os.close(r)
                try:
                    kp = PyKeePass(io.BytesIO(_read_file(path)), password=secret)
                except CredentialsError:
                    code = 3
                else:
                    payload = pickle.dumps(export_source(kp, out_kp), protocol=5)
                    with os.fdopen(w, "wb") as out:
                        out.write(struct.pack("<Q", len(payload)))
                        out.write(payload)
                    code = 0
            except BaseException:
                traceback.print_exc()
            finally:
                os._exit(code)
        os.close(w)
        try:
            header, got = _read_exact(r, 8)
            frame = None
            if got == 8:
                frame, got = _read_exact(r, struct.unpack("<Q", header)[0])
        finally:
            os.close(r)
        code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
        if code == 3:
            return None
        if code != 0 or frame is None or got != len(frame):
            raise SystemExit(f"error: failed to read {path}")
        try:
            return pickle.loads(frame)
        finally:
            wipe(frame)

    return creds.open(path, attempt)


def wipe_source(source):
    wipe(source["xml"])
    for data, _ in source["binaries"]:
        wipe(data)
    source.clear()


