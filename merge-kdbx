def _string_field(entry_el, key):
    """Return the <Value> element of the entry string field `key` (or None)."""
    for s in entry_el.findall("String"):
        if s.findtext("Key") == key:
            return s.find("Value")
    return None


def _title(entry_el):
    value = _string_field(entry_el, "Title")
    return (value.text or "") if value is not None else ""


def _set_string(entry_el, key, text):
    value = _string_field(entry_el, key)
    if value is None:
        s = etree.Element("String")
        etree.SubElement(s, "Key").text = key
        value = etree.SubElement(s, "Value")
        # keep schema order: String elements come before Binary/AutoType/History
        anchor = None
        for tag in ("Binary", "AutoType", "History"):
            anchor = entry_el.find(tag)
            if anchor is not None:
                break
        if anchor is not None:
            anchor.addprevious(s)
        else:
            entry_el.append(s)
    value.text = text


def _append_note(entry_el, line):
    notes_el = _string_field(entry_el, "Notes")
    notes = (notes_el.text or "") if notes_el is not None else ""
    _set_string(entry_el, "Notes", f"{notes}\n{line}" if notes else line)


def _lookalike_key(name):
    """Key under which names that merely look the same collide."""
    return " ".join(unicodedata.normalize("NFKC", name).casefold().split())


def _lookalike_reason(a, b):
    if unicodedata.normalize("NFC", a) == unicodedata.normalize("NFC", b):
        return "differs only in how accented characters are encoded (NFC/NFD)"
    if " ".join(a.split()) == " ".join(b.split()):
        return "differs only in spaces"
    if a.casefold() == b.casefold():
        return "differs only in letter case"
    return "differs only in case, spaces or character encoding"


def _new_uuid():
    return base64.b64encode(uuid.uuid4().bytes).decode()


# Meta elements that reference a folder by UUID
GROUP_REFS = ("RecycleBinUUID", "EntryTemplatesGroup", "LastSelectedGroup",
              "LastTopVisibleGroup")


class Merger:
    def __init__(self, out_kp, first_label, verbose=False):
        self.out = out_kp
        self.verbose = verbose
        root = out_kp.tree.getroot()
        self.out_root_group = root.find("Root/Group")
        self.uuids = {u.text for u in root.xpath(
            "//Group/UUID | //Entry[not(parent::History)]/UUID")}
        self.icons = {}
        for icon in root.xpath("/KeePassFile/Meta/CustomIcons/Icon"):
            self.icons[icon.findtext("UUID")] = icon.findtext("Data")
        # (target group UUID, base title) -> last index used
        self.last_index = {}
        # sha256(binary) -> id in output binary pool
        self.binary_ids = {}
        for i, data in enumerate(out_kp.binaries):
            self.binary_ids.setdefault(hashlib.sha256(data).hexdigest(), i)
        # output binary id -> input files (ordered) / (entry, attachment name)
        self.binary_files = {}
        self.binary_users = {}
        for e in root.xpath("//Entry[not(parent::History)]"):
            self._track_attachments(e, first_label)
        self.stats = dict(groups_created=0, groups_reused=0, groups_joined=0, lookalikes=0,
                          entries_copied=0, entries_renamed=0, attachment_notes=0)
        self._join_same_named_groups(self.out_root_group, first_label, [])

    # -- helpers --------------------------------------------------------------

    def _track_attachments(self, entry_el, label):
        for b in entry_el.findall("Binary"):
            ref = b.find("Value")
            if ref is None or ref.get("Ref") is None:
                continue
            bid = int(ref.get("Ref"))
            self.binary_files.setdefault(bid, {})[label] = None
            self.binary_users.setdefault(bid, []).append((entry_el, b.findtext("Key") or ""))

    def _unique_uuid(self, value):
        if value and value not in self.uuids:
            self.uuids.add(value)
            return value
        new = _new_uuid()
        self.uuids.add(new)
        return new

    def _fix_icons(self, el):
        for ref in el.iter("CustomIconUUID"):
            if ref.text in self.icon_map:
                ref.text = self.icon_map[ref.text]

    def _copy_custom_icons(self, src_icons):
        self.icon_map = {}
        if not len(src_icons):
            return
        meta = self.out.tree.getroot().find("Meta")
        container = meta.find("CustomIcons")
        if container is None:
            container = etree.SubElement(meta, "CustomIcons")
        for icon in list(src_icons):
            icon_uuid, data = icon.findtext("UUID"), icon.findtext("Data")
            if self.icons.get(icon_uuid) == data:
                continue
            if icon_uuid in self.icons:
                new_uuid = _new_uuid()
                self.icon_map[icon_uuid] = new_uuid
                icon.find("UUID").text = new_uuid
                icon_uuid = new_uuid
            container.append(icon)
            self.icons[icon_uuid] = data

    def _binary_id(self, src_id):
        if src_id in self.binary_map:
            return self.binary_map[src_id]
        data, protected = self.src_binaries[src_id]
        digest = hashlib.sha256(data).hexdigest()
        if digest in self.binary_ids:
            new_id = self.binary_ids[digest]
        else:
            new_id = self.out.add_binary(data, compressed=True, protected=protected)
            self.binary_ids[digest] = new_id
        self.binary_map[src_id] = new_id
        return new_id

    def _next_index(self, group_el, title):
        pattern = re.compile(re.escape(title) + r" - (\d+)$")
        highest = 0
        for e in group_el.findall("Entry"):
            m = pattern.match(_title(e))
            if m:
                highest = max(highest, int(m.group(1)))
        key = (group_el.findtext("UUID"), title)
        index = max(highest, self.last_index.get(key, 0)) + 1
        self.last_index[key] = index
        return index

    # -- merge ------------------------------------------------------------------

    def merge(self, source, source_label):
        """Merge data exported by export_source().  Source elements are moved
        (not copied) into the output tree."""
        parser = etree.XMLParser(huge_tree=True, resolve_entities=False)
        container = etree.fromstring(source["xml"], parser)
        self.source_label = source_label
        self.src_binaries = source["binaries"]
        self.binary_map = {}
        self._copy_custom_icons(container.find("CustomIcons"))
        self._merge_group(container.find("Group"), self.out_root_group, [])
        self.src_binaries = None

    def _merge_group(self, src_group, out_group, path):
        for child in list(src_group):
            if child.tag == "Entry":
                self._copy_entry(child, out_group, path)
            elif child.tag == "Group":
                name = child.findtext("Name") or ""
                target = None
                for g in out_group.findall("Group"):
                    if (g.findtext("Name") or "") == name:
                        target = g
                        break
                if target is None:
                    target = etree.Element("Group")
                    for prop in child:
                        if prop.tag not in ("Entry", "Group"):
                            target.append(copy.deepcopy(prop))
                    target.find("UUID").text = self._unique_uuid(target.findtext("UUID"))
                    self._fix_icons(target)
                    out_group.append(target)
                    self.stats["groups_created"] += 1
                    self._warn_lookalike(
                        "folder", name,
                        [g.findtext("Name") or "" for g in out_group.findall("Group")
                         if g is not target], path)
                else:
                    self.stats["groups_reused"] += 1
                self._merge_group(child, target, path + [name])

    def _warn_lookalike(self, kind, name, siblings, path):
        """Inform about a name that is not identical to, but looks like, a
        sibling's name. Such names are kept separate."""
        key = _lookalike_key(name)
        for other in siblings:
            if other != name and _lookalike_key(other) == key:
                where = "/".join(path) or "(root)"
                print(f"  note: {kind} {name!r} in {where} kept separate from {other!r}: "
                      f"{_lookalike_reason(name, other)}", file=sys.stderr)
                self.stats["lookalikes"] += 1

    def _join_same_named_groups(self, group, label, path):
        """Folders are never duplicated: sibling folders with the same name
        (possible in KDBX, folders are identified by UUID) are joined into the
        first one; their items follow the usual duplicate-title rules."""
        first_by_name = {}
        for g in group.findall("Group"):
            name = g.findtext("Name") or ""
            keep = first_by_name.setdefault(name, g)
            if keep is g:
                continue
            for child in list(g):
                if child.tag == "Entry":
                    self._place_entry(child, keep, label, path + [name])
                elif child.tag == "Group":
                    keep.append(child)        # joined in the recursion below
            notes, kept_notes = g.findtext("Notes") or "", keep.findtext("Notes") or ""
            if notes and notes != kept_notes:
                notes_el = keep.find("Notes")
                if notes_el is None:
                    notes_el = etree.Element("Notes")
                    keep.find("Name").addnext(notes_el)
                notes_el.text = f"{kept_notes}\n{notes}" if kept_notes else notes
            # references to the removed folder now point to the kept one
            gone, kept = g.findtext("UUID"), keep.findtext("UUID")
            for ref in self.out.tree.getroot().find("Meta"):
                if ref.text == gone and ref.tag in GROUP_REFS:
                    ref.text = kept
            group.remove(g)
            self.stats["groups_joined"] += 1
            if self.verbose:
                print(f"  joined folder: {'/'.join(path + [name])}", file=sys.stderr)
        names = list(first_by_name)
        for i, name in enumerate(names):
            self._warn_lookalike("folder", name, names[:i], path)
        titles = [_title(e) for e in group.findall("Entry")]
        for i, title in enumerate(titles):
            self._warn_lookalike("item", title, titles[:i], path)
        for g in group.findall("Group"):
            self._join_same_named_groups(g, label, path + [g.findtext("Name") or ""])

    def _copy_entry(self, entry, out_group, path):
        entry.find("UUID").text = self._unique_uuid(entry.findtext("UUID"))
        for ref in entry.xpath(".//Binary/Value[@Ref]"):
            ref.set("Ref", str(self._binary_id(int(ref.get("Ref")))))
        self._fix_icons(entry)
        self._place_entry(entry, out_group, self.source_label, path)
        self._track_attachments(entry, self.source_label)
        self.stats["entries_copied"] += 1

    def _place_entry(self, entry, out_group, label, path):
        """Put entry into out_group, indexing its title if already taken."""
        title = _title(entry)
        existing = {_title(e) for e in out_group.findall("Entry")}
        if title not in existing:
            self._warn_lookalike("item", title, existing, path)
        if title in existing:
            index = self._next_index(out_group, title)
            new_title = f"{title} - {index}"
            _set_string(entry, "Title", new_title)
            _append_note(entry, f"source: {label}")
            self.stats["entries_renamed"] += 1
            if self.verbose:
                print(f"  duplicate: {'/'.join(path + [title])} -> {new_title!r}",
                      file=sys.stderr)

        first_group = out_group.find("Group")
        if first_group is not None:
            first_group.addprevious(entry)
        else:
            out_group.append(entry)

    def finish(self):
        """Note on every entry whose attachment was found in several input
        files, listing all of them (command line order)."""
        for bid, files in self.binary_files.items():
            if len(files) < 2:
                continue
            where = ", ".join(files)
            for entry, name in self.binary_users[bid]:
                _append_note(entry, f'same attachment "{name}" found in: {where}')
                self.stats["attachment_notes"] += 1


